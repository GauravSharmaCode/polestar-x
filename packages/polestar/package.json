{
	"name": "@gauravsharmacode/polestar-x",
	"version": "0.1.0",
	"description": "PoleStar-X sovereign coding agent CLI - A fork of pi with enhanced model routing, self-healing retry, and cross-session memory",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GauravSharmaCode/polestar-x.git",
		"directory": "packages/polestar"
	},
	"bugs": {
		"url": "https://github.com/GauravSharmaCode/polestar-x/issues"
	},
	"homepage": "https://github.com/GauravSharmaCode/polestar-x#readme",
	"keywords": [
		"ai",
		"coding-agent",
		"cli",
		"llm",
		"claude",
		"gpt",
		"gemini",
		"terminal",
		"developer-tools"
	],
	"author": "Gaurav Sharma <gaurav@getlynx.co>",
	"piConfig": {
		"name": "polestar",
		"displayTitle": "PoleStar-X",
		"configDir": ".polestar"
	},
	"bin": {
		"polestar": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.78.0",
		"@earendil-works/pi-tui": "^0.78.0",
		"@gauravsharmacode/pi-memory": "1.0.0",
		"htmlparser2": "9.1.0",
		"turndown": "7.2.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@types/turndown": "5.0.5",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	}
}
