{
	"name": "@gauravsharmacode/polestar-x",
	"version": "0.2.0",
	"description": "PoleStar-X sovereign coding agent CLI — built on the pi SDK with enhanced model routing, self-healing retry, and cross-session memory",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GauravSharmaCode/polestar-x.git"
	},
	"bugs": {
		"url": "https://github.com/GauravSharmaCode/polestar-x/issues"
	},
	"homepage": "https://github.com/GauravSharmaCode/polestar-x#readme",
	"keywords": [
		"ai",
		"coding-agent",
		"cli",
		"llm",
		"claude",
		"gpt",
		"gemini",
		"terminal",
		"developer-tools",
		"pi-sdk"
	],
	"author": "Gaurav Sharma <gaurav@getlynx.co>",
	"piConfig": {
		"name": "polestar",
		"displayTitle": "PoleStar-X",
		"configDir": ".polestar"
	},
	"bin": {
		"polestar": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js && node scripts/vendor-pi-assets.mjs",
		"test": "vitest --run",
		"check": "npm run build && node scripts/check-package-import-deps.mjs .",
		"prepublishOnly": "npm run clean && npm run build && node scripts/check-package-import-deps.mjs .",
		"release": "node scripts/release.mjs",
		"release:dry": "node scripts/release.mjs --dry-run",
		"upgrade:pi": "node scripts/check-pi-upgrade.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.79.3",
		"@earendil-works/pi-ai": "0.79.3",
		"@earendil-works/pi-coding-agent": "0.79.3",
		"@earendil-works/pi-tui": "0.79.3",
		"@gauravsharmacode/pi-memory": "1.0.0",
		"glob": "13.0.6",
		"htmlparser2": "9.1.0",
		"turndown": "7.2.0",
		"typebox": "1.1.38"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"@types/turndown": "5.0.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
